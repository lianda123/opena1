<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DielineUV</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DielineUV.cs" />
    <Compile Include="DielineUV.Project.cs" />
    <Compile Include="DielineUV.Fold.cs" />
    <Compile Include="DielineUV.Alignment.cs" />
    <Compile Include="DielineUV.GeometryCheck.cs" />
    <Compile Include="DielineUV.SideMaterials.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Build against the first Rhino 7 SDK so new features cannot silently raise the minimum version. -->
    <PackageReference Include="RhinoCommon" Version="[7.0.20314.3001]" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
  </ItemGroup>
  <Target Name="CopyRhp" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)DielineUV.rhp" />
  </Target>
</Project>
